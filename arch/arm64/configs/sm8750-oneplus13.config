# Qualcomm SM8750 / OnePlus 13 (dodge) bringup fragment
CONFIG_LOCALVERSION="-sm8750-oneplus13"

# Core SM8750 platform
CONFIG_NR_CPUS=8
CONFIG_SCHED_CLUSTER=y
CONFIG_ARCH_QCOM=y
CONFIG_ARM64_APPENDED_DTB=y
CONFIG_PINCTRL_SM8750=y
CONFIG_SM_GCC_8750=y
CONFIG_SM_GPUCC_8750=y
CONFIG_SM_DISPCC_8750=y
CONFIG_SM_TCSRCC_8750=y
CONFIG_SM_VIDEOCC_8750=y
CONFIG_INTERCONNECT_QCOM_SM8750=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_QCOM_ICC_BWMON=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_SOCINFO=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_QCOM_APR=y
CONFIG_QCOM_FASTRPC=m
CONFIG_REMOTEPROC_CDEV=y
CONFIG_RPMSG_CHAR=y
CONFIG_QCOM_RMTFS_MEM=y

# Storage / crypto / debug boot
CONFIG_SCSI_UFS_QCOM=y
CONFIG_SCSI_UFS_BSG=y
CONFIG_SCSI_UFS_CRYPTO=y
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_CRYPTO_USER_API_AEAD=y
CONFIG_CRYPTO_DEV_QCE=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_COMPRESS=y
CONFIG_FB_SIMPLE=y

# PCIe / WLAN path from boot.img-derived WCN7850 notes
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIE_QCOM=y
CONFIG_PHY_QCOM_QMP_PCIE=y

# USB for early networking and PMIC GLINK Type-C
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_GADGET=y
CONFIG_USB_G_NCM=y
CONFIG_USB_G_SERIAL=n
CONFIG_USB_CONFIGFS=n
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=y
CONFIG_QCOM_PMIC_GLINK=y
CONFIG_UCSI_PMIC_GLINK=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_M31_EUSB=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y

# Display / GPU / LEDs
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_FLASH=y
CONFIG_LEDS_CLASS_MULTICOLOR=m
CONFIG_LEDS_QCOM_FLASH=y
CONFIG_LEDS_QCOM_LPG=m
CONFIG_LEDS_TRIGGER_PATTERN=y
CONFIG_LEDS_TRIGGER_ONESHOT=y
CONFIG_LEDS_TRIGGER_BACKLIGHT=y
CONFIG_LEDS_TRIGGER_ACTIVITY=y

# Input / HID / touchscreen experiments
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=m
CONFIG_INPUT_JOYDEV=m
CONFIG_I2C_QCOM_GENI=y
CONFIG_I2C_HID=y
CONFIG_HID_GENERIC=m
CONFIG_UHID=m
CONFIG_USB_HID=m
CONFIG_HIDRAW=y
CONFIG_HID_BATTERY_STRENGTH=y
CONFIG_SPI_GPIO=y
CONFIG_SPI_SPIDEV=m
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_HBP=m

# Sensors / thermals / IIO bringup
CONFIG_THERMAL=y
CONFIG_QCOM_TSENS=y
CONFIG_IIO=y
CONFIG_IIO_KFIFO_BUF=y
CONFIG_IIO_TRIGGERED_BUFFER=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_SPMI_ADC_TM5=y
CONFIG_QCOM_VADC_COMMON=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y

# NFC / IR experiments from downstream hardware map
CONFIG_NFC=m
CONFIG_NFC_NCI=m
CONFIG_NFC_NCI_SPI=m
CONFIG_NFC_NCI_UART=m
CONFIG_NFC_PN544=m
CONFIG_NFC_PN544_I2C=m
CONFIG_RC_CORE=m
CONFIG_LIRC=y
CONFIG_IR_SPI=m

# WLAN / Bluetooth bringup
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_ATH12K=m
CONFIG_ATH12K_PCI=m
CONFIG_ATH12K_DEBUG=y
CONFIG_ATH12K_DEBUGFS=y
CONFIG_CFG80211_DEBUGFS=y
CONFIG_MAC80211_DEBUGFS=y
CONFIG_BT=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m
CONFIG_BT_HS=y
CONFIG_BT_LE=y
CONFIG_BT_QCA=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_QCA=y

# Audio skeleton for later LPASS/SoundWire port
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_QCOM=m
CONFIG_SND_USB_AUDIO=m

# postmarketOS basics
CONFIG_TMPFS_XATTR=y
CONFIG_CRYPTO_XTS=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_F2FS_FS=y
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_PSI=y
CONFIG_ZSMALLOC=m
CONFIG_ZRAM=m
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_DEF_COMP="zstd"
CONFIG_ZRAM_MEMORY_TRACKING=y
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_WIREGUARD=m
CONFIG_NLS_UTF8=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_EXFAT_FS=m
CONFIG_CGROUP_FREEZER=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_CHECKPOINT_RESTORE=y
