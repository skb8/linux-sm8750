// SPDX-License-Identifier: BSD-3-Clause
/*
 * Initial mainline-oriented device tree for OnePlus 13 (dodge).
 *
 * Based on the sm8750-mainline OnePlus-13-WIP tree and cross-checked
 * against OnePlusOSS sm8750_b_16.0.0_oneplus_13 downstream overlays.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "sm8750.dtsi"
#include "pm8010.dtsi"
#include "pm8550.dtsi"
#define PMK8550VE_SID 8
#include "pm8550ve.dtsi"
#include "pmih0108.dtsi"
#include "pmk8550.dtsi"
#include "pmr735d_a.dtsi"
#include "sm8750-pmics.dtsi"

/ {
	model = "OnePlus 13";
	compatible = "oneplus,dodge", "qcom,sm8750";
	chassis-type = "handset";

	aliases {
		serial0 = &uart7;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		framebuffer: framebuffer@fc800000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xfc800000 0x0 0x2b00000>;
			width = <1440>;
			height = <3168>;
			stride = <(1440 * 4)>;
			format = "a8r8g8b8";
		};
	};

	clocks {
		xo_board: xo-board {
			compatible = "fixed-clock";
			clock-frequency = <76800000>;
			#clock-cells = <0>;
		};

		sleep_clk: sleep-clk {
			compatible = "fixed-clock";
			clock-frequency = <32000>;
			#clock-cells = <0>;
		};

		bi_tcxo_div2: bi-tcxo-div2-clk {
			compatible = "fixed-factor-clock";
			#clock-cells = <0>;
			clocks = <&rpmhcc RPMH_CXO_CLK>;
			clock-mult = <1>;
			clock-div = <2>;
		};

		bi_tcxo_ao_div2: bi-tcxo-ao-div2-clk {
			compatible = "fixed-factor-clock";
			#clock-cells = <0>;
			clocks = <&rpmhcc RPMH_CXO_CLK_A>;
			clock-mult = <1>;
			clock-div = <2>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		key-volume-down {
			label = "Volume Down";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&pm8550_gpios 6 GPIO_ACTIVE_LOW>;
			debounce-interval = <15>;
			linux,can-disable;
			wakeup-source;
		};
	};

	pmic-glink {
		compatible = "qcom,sm8750-pmic-glink", "qcom,pmic-glink";
		#address-cells = <1>;
		#size-cells = <0>;
		/* Downstream leaves the orientation GPIO unresolved for dodge. */
	};

	vph_pwr: vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <3700000>;
		regulator-max-microvolt = <3700000>;
		regulator-always-on;
		regulator-boot-on;
	};
};

&{/memory@a0000000} {
	device_type = "memory";
	/* OnePlus 13 16 GiB layout from the sm8750-mainline dodge tree. */
	reg = <0x0 0x81960000 0x0 0xa0000>,
	      <0x0 0x81a40000 0x0 0x1c0000>,
	      <0x0 0x81cf4000 0x0 0xc000>,
	      <0x0 0x82460000 0x0 0x40000>,
	      <0x0 0xe3720000 0x0 0x1c0e0000>,
	      <0x8 0x80000000 0x0 0x2f700000>,
	      <0x8 0xb0000000 0x0 0x52c0000>,
	      <0xa 0x00000000 0x2 0x00000000>,
	      <0x8 0xc0000000 0x1 0x40000000>,
	      <0x0 0x82800000 0x0 0x2200000>,
	      <0x0 0x89d80000 0x0 0x1c80000>,
	      <0x0 0xa4880000 0x0 0x13780000>,
	      <0x0 0xb81c0000 0x0 0x1cc63000>,
	      <0x0 0xd5100000 0x0 0x2f00000>;
};

/* Keep the debug UART available for bringup kernels. */
&uart7 {
	status = "okay";
};
